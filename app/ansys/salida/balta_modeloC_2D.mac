! --- frecuencias a un archivo de texto (frecuencias_modeloC.txt en la carpeta de trabajo)
/POST1
SET,LIST
*DIM,FREQ,ARRAY,8
*DO,I,1,8
  *GET,FREQ(I),MODE,I,FREQ
*ENDDO
*CFOPEN,frecuencias_modeloC,txt
*VWRITE
('    Modo        f_Hz')
*DO,I,1,8
*VWRITE,I,FREQ(I)
(F8.0,F12.4)
*ENDDO
*CFCLOS
/ESHAPE,1
/VIEW,1,1,0,0
SET,1,1
PLDISP,1
